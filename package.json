{
  "name": "opencode-ultra",
  "version": "0.1.0",
  "description": "Auto mode + ultracode dynamic workflows for opencode.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "command",
    "skills",
    "agent",
    "scripts"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --log-level=warning",
    "verify": "npm run build && node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:local": "node scripts/install.js --local",
    "install:global": "node scripts/install.js --global",
    "uninstall:local": "node scripts/uninstall.js",
    "uninstall:global": "node scripts/uninstall.js --global",
    "install:dry": "node scripts/install.js --local --dry-run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.16.0",
    "@opencode-ai/sdk": ">=1.16.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.16.0",
    "@opencode-ai/sdk": "^1.16.0",
    "@types/node": "^25.9.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "opencode",
    "plugin",
    "auto-mode",
    "workflow",
    "agent"
  ],
  "license": "MIT"
}
